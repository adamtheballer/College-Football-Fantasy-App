meta {
  name: Schools
  type: http
  seq: 3
}
put {
  url: {{base_url}}/weekly-challenges/experiences/{{weekly_challenge_id}}/allegiance
  body: json
}
headers {
  Authorization: Bearer {{access_token}}
}
body:json {
  {"school_id": {{challenge_school_id}}}
}
docs {
  See docs/operations/challenge-experiences.md. Use an isolated environment first.
  IDs and versions must come from real API responses. Review and publish using
  the existing WeeklyChallenges Validate/Publish requests; draft configuration alone never opens entries.
}
