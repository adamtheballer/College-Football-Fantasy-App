meta {
  name: Admin cancel without deleting history
  type: http
  seq: 18
}
post {
  url: {{base_url}}/admin/weekly-challenges/challenges/{{weekly_challenge_id}}/cancel
  body: json
}
headers {
  Authorization: Bearer {{access_token}}
}
body:json {
  {"expected_version": {{challenge_version}}, "reason": "Published challenge cannot be completed"}
}
docs {
  Combined-release feature: run only against the isolated local preview until release approval.
  Read current IDs, publication version and entry revision from API responses.
  SaveEntry and Configure examples are for Lock of the Week; other formats need their complete published selections.
}
