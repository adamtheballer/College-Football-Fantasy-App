FROM node:20 AS build

WORKDIR /app/web

ARG CFF_GIT_SHA=unknown
ARG CFF_GIT_BRANCH=unknown
ARG VITE_BETA_ACCESS_ENABLED=false
# This is a public OneSignal application identifier, never an API key.
ARG VITE_ONESIGNAL_APP_ID=

LABEL org.opencontainers.image.revision=${CFF_GIT_SHA} \
    org.opencontainers.image.version=${CFF_GIT_BRANCH}

COPY web/package.json web/package-lock.json ./
RUN npm install --global npm@10.9.3
RUN npm ci

COPY web ./

ENV VITE_API_BASE_URL=/api
ENV VITE_BETA_ACCESS_ENABLED=${VITE_BETA_ACCESS_ENABLED}
ENV VITE_ONESIGNAL_APP_ID=${VITE_ONESIGNAL_APP_ID}
ENV VITE_GIT_SHA=${CFF_GIT_SHA}
ENV VITE_GIT_BRANCH=${CFF_GIT_BRANCH}
RUN npm run build

FROM nginx:1.27-alpine

ARG CFF_GIT_SHA=unknown
ARG CFF_GIT_BRANCH=unknown

LABEL org.opencontainers.image.revision=${CFF_GIT_SHA} \
    org.opencontainers.image.version=${CFF_GIT_BRANCH}

COPY --from=build /app/web/dist/spa /usr/share/nginx/html
# Vite preserves source file modes when it copies public assets.  Ensure nginx
# can read every generated static file regardless of the source attachment's
# original permissions.
RUN find /usr/share/nginx/html -type f -exec chmod 0644 {} +
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
