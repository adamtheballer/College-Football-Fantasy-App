FROM python:3.11-slim

WORKDIR /app

ARG CFF_GIT_SHA=unknown
ARG CFF_GIT_BRANCH=unknown

LABEL org.opencontainers.image.revision=${CFF_GIT_SHA} \
    org.opencontainers.image.version=${CFF_GIT_BRANCH}

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/cff-api-venv \
    GIT_SHA=${CFF_GIT_SHA} \
    GIT_BRANCH=${CFF_GIT_BRANCH}

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

COPY . .

# These five files are the immutable inputs to the runtime's pre-season source
# contract. Keep them in an explicit final layer: the API must boot from the
# exact identity/projection snapshot whose manifest is verified at startup,
# rather than silently accepting an incomplete broad-context copy.
COPY reports/source-imports/2026/player-identities.csv reports/source-imports/2026/player-projections.csv reports/source-imports/2026/player-identities.manifest.json reports/source-imports/2026/player-projections.manifest.json reports/source-imports/2026/source-manifest.json /app/reports/source-imports/2026/
